{
  "name": "@dg-design/react",
  "version": "0.1.0",
  "description": "Dogeol Design System(DDS)의 React 컴포넌트 패키지.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoGeol/dg-design.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/DoGeol/dg-design#readme",
  "bugs": "https://github.com/DoGeol/dg-design/issues",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "publint": "^0.3.23",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}