{
  "name": "@dg-design/tokens",
  "version": "0.3.0",
  "description": "Dogeol Design System(DDS)의 디자인 토큰 패키지. OKLCH 파생 팔레트를 CSS 변수·Tailwind v4 브릿지·타입으로 생성한다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoGeol/dg-design.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/DoGeol/dg-design#readme",
  "bugs": "https://github.com/DoGeol/dg-design/issues",
  "keywords": [
    "design-system",
    "design-tokens",
    "css-variables",
    "oklch",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node --disable-warning=ExperimentalWarning src/generate.ts",
    "build": "pnpm run generate",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "catalog:"
  }
}
